[Unit]
Description=BCTC Streamlit Dashboard Web App
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bctc_alert
ExecStart=/home/ubuntu/bctc_alert/venv/bin/streamlit run streamlit_app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/bctc_alert/streamlit.log
StandardError=append:/home/ubuntu/bctc_alert/streamlit.log

[Install]
WantedBy=multi-user.target
